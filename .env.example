# Canonical site origin. Used for metadata (canonical, og:url, og:image), sitemap.xml, robots.txt, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://yogawritecode.com

# Google Tag Manager container ID. Loads only after the visitor accepts analytics and fires the GA4 tag. Set to an empty value to disable it.
NEXT_PUBLIC_GTM_CONTAINER_ID=GTM-K8MFHGSC

# Microsoft Clarity project ID. Loads only after the visitor accepts analytics. Set to an empty value to disable it.
NEXT_PUBLIC_CLARITY_PROJECT_ID=yo9d18nwgq

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Use the project's anon key (or the newer publishable key if Supabase gives you that name).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI provider: "mock" or "bedrock"
AI_MODE=mock

# Bedrock (only when AI_MODE=bedrock)
AWS_REGION=ap-southeast-2
# Active Anthropic cross-region inference profile for Sydney.
BEDROCK_MODEL_ID=au.anthropic.claude-sonnet-4-5-20250929-v1:0
AWS_BEARER_TOKEN_BEDROCK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
